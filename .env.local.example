# Anthropic API key for the in-app Advisor Copilot (server-side only).
# Get one at https://console.anthropic.com/ — copy this file to `.env.local`
# and fill in your key. Never commit your real key.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the copilot model (defaults to claude-sonnet-4-6).
ADVISOR_MODEL=claude-sonnet-4-6

# Optional: override the "Plano Ideal" model (defaults to claude-opus-4-8, the
# most capable real model). NOTE: never use "claude-fable-5" — that is only a
# local Claude Code alias, the Anthropic API does not accept it.
PLANO_IDEAL_MODEL=claude-opus-4-8

# Neon Postgres connection string (server-side only) for scenario persistence.
# On Vercel this is injected automatically by the Vercel → Neon integration.
# Locally: provision Neon, copy its pooled connection string here, then run
# `npm run db:migrate`. Without it, the app still works on localStorage only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# v6 - Gate de demonstracao (tela preta antes de tudo). Sem esta env o gate
# fica DESARMADO (fail-open documentado). Defina tambem nas envs da Vercel.
# Gate de demonstracao apenas - NAO e autenticacao de producao.
GATE_PASSWORD=
