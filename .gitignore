# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# demo video pipeline (raw clips + renders are regenerable)
/demo/raw/
/demo/out/
# demo narrado: artefatos gerados (TTS cache, frames do avatar, temporários)
/demo/narrate/tts/
/demo/narrate/frames/
/demo/narrate/tmp/
/demo/narrate/chapters/
/demo/narrate/avatar/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
